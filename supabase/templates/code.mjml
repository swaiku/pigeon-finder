<mjml lang="en">
  <mj-head>
    <mj-title>Your Pigeon Finder code</mj-title>
    <mj-preview>Your code: {{ .Token }}</mj-preview>
    <mj-font name="Fredoka" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&amp;display=swap" />
    <mj-font name="Nunito" href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800&amp;display=swap" />
    <mj-attributes>
      <mj-all font-family="Nunito, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.5" color="#5C6F8A" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#FBF7EF">
    <mj-section padding="32px 16px 8px">
      <mj-column>
        <mj-image src="https://raw.githubusercontent.com/swaiku/pigeon-finder/main/supabase/templates/logo.png" alt="Pigeon Finder" width="96px" border-radius="26px" padding-bottom="12px" />
        <mj-text align="center" font-family="Fredoka, Arial, sans-serif" font-size="32px" font-weight="700" color="#1F3A5F">
          Pigeon Finder
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" border-radius="20px" padding="16px 8px" css-class="card">
      <mj-column>
        <mj-text align="center" font-family="Fredoka, Arial, sans-serif" font-size="24px" font-weight="700" color="#1F3A5F" padding-bottom="4px">
          Your login code
        </mj-text>
        <mj-text align="center">
          Enter this code in the app to continue.
        </mj-text>
        <mj-text align="center" font-family="Fredoka, Arial, sans-serif" font-size="40px" font-weight="700" letter-spacing="10px" color="#EE3350" container-background-color="#FBF7EF" padding="16px 24px">
          {{ .Token }}
        </mj-text>
        <mj-text align="center" font-size="13px" color="#8A98AE">
          The code expires in 1 hour.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px 16px 32px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#8A98AE">
          Didn't ask for it? Just ignore this email: nobody can log in without this code.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
